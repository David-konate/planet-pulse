# Database host or full connection URL
DB_URL=<URL>
# Port the database listens on (PostgreSQL default: 5432)
DB_PORT=<number_port>
# Name of the database
DB_NAME=<name_the_base>
# Database user
DB_USER=<username>
# Database password
DB_PASSWORD=<password>
# API key used to access the external service
API_KEY=<api_key>
